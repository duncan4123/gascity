+    OR COALESCE(sl.has_session_label, 0) = 1
+    OR NULLIF(ai.session_name_meta, '') IS NOT NULL
+    OR NULLIF(ai.template_meta, '') IS NOT NULL
+    OR NULLIF(ai.configured_named_identity, '') IS NOT NULL;
