+         fs.needs, fs.run_target, fs.child_formula, fs.expand_formula, fs.condition, fs.parent_template
+    FROM workflow_roots wr
+    JOIN formula_steps fs ON fs.formula = wr.formula
+),
+actual_steps AS (
