++		{"explicit wildcard preserved", "0.0.0.0", "0.0.0.0"},
++		{"explicit remote preserved", "db.example.com", "db.example.com"},
++	}
++	for _, tc := range cases {
++		t.Run(tc.name, func(t *testing.T) {
++			script := line + "\nprintf '%s' \"$DOLT_HOST\"\n"
