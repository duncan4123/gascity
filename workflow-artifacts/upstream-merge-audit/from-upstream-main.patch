+	if retryErr == nil {
+		return retry, nil
+	}
+	existing, err = existingGraphV2Root(store, recipe)
+	if err != nil {
+		return nil, errors.Join(firstErr, retryErr, err)
+	}
+	if existing != nil {
+		return existing, nil
+	}
+	return nil, errors.Join(firstErr, retryErr)
