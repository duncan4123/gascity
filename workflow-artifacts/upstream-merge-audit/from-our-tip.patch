+func TestRetainScaleCheckPartialPoolDesired_InFlightCreatingBeadRetained(t *testing.T) {
+	cfg := &config.City{
+		Workspace: config.Workspace{Name: "test-city"},
+		Agents: []config.Agent{{
+			Name:              "worker",
