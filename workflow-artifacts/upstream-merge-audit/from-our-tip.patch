+		ID: "creating-inflight", Type: sessionBeadType, Status: "open",
+		Metadata: map[string]string{
+			"template":             template,
+			"session_name":         "worker-1",
+			"state":                "creating",
+			"pending_create_claim": boolMetadata(true),
+			poolManagedMetadataKey: boolMetadata(true),
+		},
