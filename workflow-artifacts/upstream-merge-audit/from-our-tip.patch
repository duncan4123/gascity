+	t.Run("legacy_toml", func(t *testing.T) {
+		want := writeLayerFile(t, dir, "mol-b.formula.toml", "")
+		bare, okBare := Resolve([]string{dir}, "mol-b")
+		withExt, okExt := Resolve([]string{dir}, "mol-b.formula.toml")
